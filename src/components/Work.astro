---
import { Image } from 'astro:assets';
import bancorCurrencyExchange from '../assets/bancor-currency-exchange.png';
import bancorBusinessCards from '../assets/bancor-business-cards.png';
import peopledesk from '../assets/peopledesk.png';
import strand from '../assets/strand.png';
import peopledeskDS from '../assets/peopledesk-design-system.png';
import matinee from '../assets/matinee.png';
---

<section class="sec" id="work">
  <div class="wrap">
    <div class="sec-head rise">
      <div>
        <span class="eyebrow">Selected work</span>
        <h2>Banking, B2B SaaS and self-initiated products</h2>
      </div>
      <span class="side">6 case studies</span>
    </div>
    <div class="work">

      <a class="card rise" href="/work/bancor-currency-exchange">
        <div class="card-img"><Image src={bancorCurrencyExchange} alt="Bancor currency exchange flow on mobile" width={1040} height={693} loading="lazy" /><span class="card-go"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M7 7h10v10"/></svg></span></div>
        <div class="card-body">
          <div class="card-top"><h3>Bancor Currency Exchange</h3><span class="card-year">2026</span></div>
          <p class="card-desc">Foreign currency exchange for retail banking. From balance to settled trade in a single flow, with instant accreditation.</p>
          <div class="chips"><span class="chip chip--status">Launching soon</span><span class="chip">Product Design</span><span class="chip">Fintech</span><span class="chip">Mobile</span></div>
        </div>
      </a>

      <a class="card rise" href="/work/bancor-business-cards">
        <div class="card-img"><Image src={bancorBusinessCards} alt="Bancor corporate card management dashboard" width={1040} height={693} loading="lazy" /><span class="card-go"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M7 7h10v10"/></svg></span></div>
        <div class="card-body">
          <div class="card-top"><h3>Bancor Business Cards</h3><span class="card-year">2026</span></div>
          <p class="card-desc">Corporate card management for business clients. Limits, users and spend visibility unified in one dashboard.</p>
          <div class="chips"><span class="chip">Product Design</span><span class="chip">B2B</span><span class="chip">Enterprise</span><span class="chip">Design System</span></div>
        </div>
      </a>

      <a class="card rise" href="/work/peopledesk-case-study">
        <div class="card-img"><Image src={peopledesk} alt="PeopleDesk payroll dashboard" width={1040} height={693} loading="lazy" /><span class="card-go"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M7 7h10v10"/></svg></span></div>
        <div class="card-body">
          <div class="card-top"><h3>PeopleDesk</h3><span class="card-year">2024</span></div>
          <p class="card-desc">HR, payroll and finance unified in one B2B platform. Three flows and fourteen screens, designed end to end.</p>
          <div class="chips"><span class="chip">B2B SaaS</span><span class="chip">Product Design</span><span class="chip">Lead Product Designer</span></div>
        </div>
      </a>

      <a class="card rise" href="/work/strand-case-study">
        <div class="card-img"><Image src={strand} alt="Strand creative performance analytics interface" width={1040} height={693} loading="lazy" /><span class="card-go"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M7 7h10v10"/></svg></span></div>
        <div class="card-body">
          <div class="card-top"><h3>Strand</h3><span class="card-year">2026</span></div>
          <p class="card-desc">Creative performance intelligence. Turning campaign signals into decisions marketing teams can act on.</p>
          <div class="chips"><span class="chip chip--status">Concept</span><span class="chip">Data Visualisation</span><span class="chip">Product Design</span></div>
        </div>
      </a>

      <a class="card rise" href="/work/matinee">
        <div class="card-img"><Image src={matinee} alt="Matinee: the logo above two phones showing the watchlist and published before-and-after notes on a film page" width={1040} height={693} loading="lazy" /><span class="card-go"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M7 7h10v10"/></svg></span></div>
        <div class="card-body">
          <div class="card-top"><h3>Matinee</h3><span class="card-year">2026</span></div>
          <p class="card-desc">A film community app with no ratings. Product decisions, a design system and a working build in production, end to end.</p>
          <div class="chips"><span class="chip chip--status">Self-initiated</span><span class="chip">Product Design</span><span class="chip">Design System</span><span class="chip">Shipping</span></div>
        </div>
      </a>

      <a class="card rise" href="/work/peopledesk-design-system">
        <div class="card-img"><Image src={peopledeskDS} alt="PeopleDesk design system: colour ramps, components and tokens" width={1040} height={693} loading="lazy" /><span class="card-go"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 17L17 7M7 7h10v10"/></svg></span></div>
        <div class="card-body">
          <div class="card-top"><h3>PeopleDesk Design System</h3><span class="card-year">2024</span></div>
          <p class="card-desc">Tokens, components and patterns for a white-label HR and payroll platform, documented for teams that never meet its designer.</p>
          <div class="chips"><span class="chip">Design Systems</span><span class="chip">Design Tokens</span><span class="chip">B2B SaaS</span></div>
        </div>
      </a>

    </div>
  </div>
</section>
